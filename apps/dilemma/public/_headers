# Cloudflare Pages headers (TEKNIK §9.2 / §4.7).
# COOP must stay "same-origin-allow-popups" so child universe windows keep `opener`.
# Never "same-origin"; never add Cross-Origin-Embedder-Policy: require-corp.

/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/stresst/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Content-Type: application/wasm

/assets/*.wasm
  Content-Type: application/wasm

/stresst/assets/*.wasm
  Content-Type: application/wasm
