{
  "name": "@dilemma/app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:qa": "vite build --mode qa",
    "preview": "vite build && vite preview --port 4182 --strictPort",
    "preview:qa": "vite build --mode qa && vite preview --mode qa --port 4181 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
